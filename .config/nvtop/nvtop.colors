# NVTOP Color Configuration Template
# Format: color_name = RGB_HEX_VALUE
# Colors must be specified as 6-digit hex values without # prefix

# Background colors
background = #141312
selected_bg = #211f1e
header_bg = #4c463e

# Text colors
text = #e6e1df
selected_text = #d2c5b4
header_text = #cec5bb
inactive_text = #978f86

# GPU utilization colors (gradient from low to high)
gpu_util_low = #ffdd76
gpu_util_med = #ffefd9
gpu_util_high = #f3a249

# Memory usage colors
memory_low = #f2e08a
memory_med = #b3d27e
memory_high = #ffa2bd

# Temperature colors (cool to hot)
temp_cool = #ffdd76
temp_warm = #ffefd9
temp_hot = #f3a249

# Power usage colors
power_low = #ffdd76
power_med = #f8c581
power_high = #eeb377

# Process list colors
process_normal = #e6e1df
process_highlight = #d2c5b4
process_killed = #f3a249

# Border and separator colors
border = #978f86
separator = #4c463e

# Chart and graph colors
chart_line = #c5c6cf
chart_fill = #211f1e

# Status indicators
status_ok = #ffdd76
status_warning = #ffefd9
status_error = #f3a249
status_info = #ffa2bd
